Options -Indexes
DirectoryIndex index.php

# Never serve the SQL dump or config backups over the web
<FilesMatch "\.(sql|md|bak|ini|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
